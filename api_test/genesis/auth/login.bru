meta {
  name: login
  type: http
  seq: 1
}

post {
  url: https://localhost/genesis/public/api/login
  body: json
  auth: inherit
}

body:json {
  {{admin}}
  // {{user}}
  
}

vars:pre-request {
  admin: {"email": "admin1@example.com","password": "AdminPassword1!"}
  user: {"email": "user1@example.com","password": "UserPassword1!"}
}
