{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env-cmd -f .env.local next dev",
    "build": "env-cmd -f .env next build && sitemap",
    "out": "env-cmd -f .env next build && sitemap && post-build",
    "sitemap": "tsc next-sitemap.config.ts --esModuleInterop && env-cmd -f .env next-sitemap",
    "post-build": "node scripts/post-build.js",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.5",
    "motion": "^12.18.1",
    "next": "^15.3.4",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.2",
    "swiper": "^11.2.8",
    "tailwindcss": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "env-cmd": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "fs-extra": "^11.3.0",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "^5.8.3"
  }
}
